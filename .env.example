# Application Settings
APP_NAME=Enterprise-Prod-RAG
APP_ENV=development
DEBUG=true
SECRET_KEY=super-secret-key-change-in-production-32-bytes-minimum

# Database & Cache Configurations
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=


REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=documents_collection

# MinIO / S3 Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rag-documents
S3_REGION=us-east-1

# Message Queue & Celery
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & Presidio
ENABLE_PII_REDACTION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Observability
OTEL_COLLECTOR_URL=http://localhost:4317
ENABLE_TELEMETRY=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Groq LLM & Gemini Embeddings
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Other LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
